[Unit]
Description=Tonny Pipecat and Cartesia Line voice gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@RELEASE@
Environment=PATH=@TOOL_PATH@
ExecStart=/bin/bash @RELEASE@/deploy/tonny/run-voice
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
